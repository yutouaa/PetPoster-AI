.page-shell {
  min-height: 100vh;
  background:
    radial-gradient(1200rpx 600rpx at 10% -10%, #F4E4DA 0%, rgba(244, 228, 218, 0) 60%),
    radial-gradient(800rpx 500rpx at 110% 10%, #E4ECE9 0%, rgba(228, 236, 233, 0) 55%),
    #F7F2EA;
  color: #161311;
}

tab-bar {
  background: transparent;
}

.screen {
  position: relative;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  height: 100vh;
  overflow: hidden;
  background: transparent;
  opacity: 0;
  transition: opacity 0.24s ease;
}

.screen-in {
  opacity: 1;
}

.home-topbar {
  height: 77rpx;
  padding: 0 38rpx 15rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-wrap,
.top-actions,
.cta-right,
.current-style,
.progress-head,
.archive-head,
.inbox-head,
.profile-main,
.sheet-head,
.hero-foot,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-wrap {
  justify-content: flex-start;
}

.brand-logo {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #161311;
  color: #FFFFFF;
  font-family: "Cormorant Garamond", "Noto Serif SC", "Songti SC", serif;
  font-size: 31rpx;
  font-style: italic;
  font-weight: 600;
  margin-right: 15rpx;
}

.brand-name,
.display,
.hero-title,
.hero-style,
.cta-title,
.sheet-title,
.style-name,
.current-name,
.poster-title,
.result-title,
.history-title,
.profile-name,
.promo-title,
.balance-row text:first-child,
.percent,
.stat text:first-child,
.purchase-price text:first-child {
  font-family: "Cormorant Garamond", "Noto Serif SC", "Songti SC", Georgia, serif;
}

.brand-name {
  font-size: 33rpx;
  font-weight: 600;
  line-height: 1;
}

.top-actions {
  justify-content: flex-end;
}

.round-icon {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #E8DFD4;
  color: #161311;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 15rpx;
  transition: transform 0.15s ease, opacity 0.2s ease;
}

.round-icon:active {
  transform: scale(0.96);
  opacity: 0.82;
}

.notice-dot {
  position: relative;
}

.notice-dot::after {
  content: "";
  position: absolute;
  right: 15rpx;
  top: 15rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C2502B;
}

.icon-img {
  width: 27rpx;
  height: 27rpx;
}

.scroll-content {
  height: calc(100vh - 165rpx);
  padding: 0 38rpx;
  background: transparent;
}

.home-scroll {
  height: calc(100vh - 161rpx);
  padding-bottom: calc(196rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(1200rpx 600rpx at 10% -10%, #F4E4DA 0%, rgba(244, 228, 218, 0) 60%),
    radial-gradient(800rpx 500rpx at 110% 10%, #E4ECE9 0%, rgba(228, 236, 233, 0) 55%),
    #F7F2EA;
}

.plain-scroll {
  padding-bottom: calc(31rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(31rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(1200rpx 600rpx at 10% -10%, #F4E4DA 0%, rgba(244, 228, 218, 0) 60%),
    radial-gradient(800rpx 500rpx at 110% 10%, #E4ECE9 0%, rgba(228, 236, 233, 0) 55%),
    #F7F2EA;
}

.style-scroll {
  padding-bottom: calc(284rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(284rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(1200rpx 600rpx at 10% -10%, #F4E4DA 0%, rgba(244, 228, 218, 0) 60%),
    radial-gradient(800rpx 500rpx at 110% 10%, #E4ECE9 0%, rgba(228, 236, 233, 0) 55%),
    #F7F2EA;
}

.result-scroll {
  padding-bottom: calc(15rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(15rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(1200rpx 600rpx at 10% -10%, #F4E4DA 0%, rgba(244, 228, 218, 0) 60%),
    radial-gradient(800rpx 500rpx at 110% 10%, #E4ECE9 0%, rgba(228, 236, 233, 0) 55%),
    #F7F2EA;
}

.mine-scroll {
  padding-bottom: calc(76rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(76rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(1200rpx 600rpx at 10% -10%, #F4E4DA 0%, rgba(244, 228, 218, 0) 60%),
    radial-gradient(800rpx 500rpx at 110% 10%, #E4ECE9 0%, rgba(228, 236, 233, 0) 55%),
    #F7F2EA;
}

.hero-card {
  position: relative;
  width: 100%;
  height: 842rpx;
  margin-top: 15rpx;
  overflow: hidden;
  border-radius: 31rpx;
  text-align: left;
  background: #161311;
  transition: transform 0.15s ease;
}

.hero-card:active {
  transform: scale(0.985);
}

.hero-img,
.fill-img {
  width: 100%;
  height: 100%;
}

.hero-mask,
.card-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.15) 55%, rgba(0, 0, 0, 0.25));
}

.card-shade {
  background: linear-gradient(to top, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.15));
}

.card-shade.strong {
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 56%, rgba(0, 0, 0, 0.2));
}

.hero-copy {
  position: absolute;
  left: 38rpx;
  right: 38rpx;
  top: 38rpx;
  color: #FFFFFF;
}

.overline {
  display: block;
  font-size: 19rpx;
  letter-spacing: 6rpx;
  color: #8C817A;
  line-height: 1.5;
}

.light {
  color: #FFFFFF;
}

.muted-light {
  opacity: 0.78;
}

.hero-title {
  margin-top: 15rpx;
  font-size: 62rpx;
  font-weight: 500;
  line-height: 1.05;
  color: #FFFFFF;
}

.hero-title text {
  display: block;
}

.italic {
  font-style: italic;
}

.accent {
  color: #C2502B;
}

.hero-foot {
  position: absolute;
  left: 38rpx;
  right: 38rpx;
  bottom: 38rpx;
  color: #FFFFFF;
}

.hero-style {
  display: block;
  margin-top: 4rpx;
  font-size: 42rpx;
  font-weight: 500;
}

.view-pill {
  height: 69rpx;
  border-radius: 35rpx;
  padding: 0 23rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  color: #161311;
  font-size: 21rpx;
  transition: transform 0.15s ease;
}

.view-pill:active {
  transform: scale(0.98);
}

.chev-icon {
  width: 23rpx;
  height: 23rpx;
  margin-left: 6rpx;
}

.row-chev {
  width: 27rpx;
  height: 27rpx;
  flex: 0 0 27rpx;
}

.section-head {
  margin-top: 54rpx;
}

.display {
  display: inline;
  color: #161311;
  font-size: 50rpx;
  line-height: 1.1;
  font-weight: 500;
}

.display.small {
  display: block;
  font-size: 38rpx;
}

.display.mid {
  font-size: 46rpx;
}

.section-note,
.subcopy,
.hint-text,
.history-date,
.profile-sub,
.promo-sub,
.hint-center,
.version {
  color: #8C817A;
  font-size: 21rpx;
}

.hairline,
.soft-line {
  height: 2rpx;
  background: #E8DFD4;
}

.hairline {
  margin-top: 21rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  margin-top: 23rpx;
}

.photo-tile,
.photo-add {
  position: relative;
  width: 214rpx;
  height: 214rpx;
  margin-right: 16rpx;
  margin-bottom: 15rpx;
  overflow: hidden;
  border-radius: 23rpx;
}

.photo-grid .photo-tile:nth-child(3n),
.photo-grid .photo-add:nth-child(3n) {
  margin-right: 0;
}

.photo-tile {
  border: 2rpx solid rgba(0, 0, 0, 0.05);
}

.photo-pop {
  animation: photoPop 0.42s cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes photoPop {
  0% {
    opacity: 0;
    transform: scale(0.92);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.cover-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.92);
  padding: 4rpx 12rpx;
  color: #161311;
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.photo-add {
  border: 2rpx dashed #C8BFB5;
  background: rgba(255, 255, 255, 0.45);
  color: #8C817A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, background 0.2s ease;
}

.photo-add:active {
  transform: scale(0.97);
  background: rgba(255, 255, 255, 0.66);
}

.add-plus {
  width: 36rpx;
  height: 36rpx;
}

.add-label {
  margin-top: 8rpx;
  font-size: 19rpx;
  letter-spacing: 3rpx;
}

.hint-text {
  display: block;
  margin-top: 15rpx;
}

.home-cta-wrap {
  position: absolute;
  left: 38rpx;
  right: 38rpx;
  bottom: calc(72rpx + constant(safe-area-inset-bottom));
  bottom: calc(72rpx + env(safe-area-inset-bottom));
  z-index: 11;
  padding: 0;
  margin: 0;
  background: transparent;
  box-sizing: border-box;
}

.home-cta {
  width: 100%;
  min-height: 112rpx;
  border-radius: 31rpx;
  background: #161311;
  border: 2rpx solid #161311;
  color: #FFFFFF;
  padding: 21rpx 31rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: none;
  transition: transform 0.15s ease, opacity 0.2s ease;
}

.home-cta:active {
  transform: scale(0.98);
}

.home-cta[disabled] {
  opacity: 0.4;
}

.home-cta[disabled]:active {
  transform: none;
}

.cta-copy {
  text-align: left;
}

.cta-title {
  display: block;
  margin-top: 4rpx;
  font-size: 35rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.home-cta .light {
  color: #FFFFFF;
}

.home-cta .muted-light {
  opacity: 0.7;
}

.cta-count {
  text-align: right;
}

.count-num {
  display: block;
  font-family: "Cormorant Garamond", "Noto Serif SC", serif;
  font-size: 25rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.cta-arrow {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 0;
  color: #161311;
  margin-left: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta-arrow-icon {
  width: 31rpx;
  height: 31rpx;
}

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.sheet-mask-on {
  opacity: 1;
}

.sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 31;
  border-radius: 46rpx 46rpx 0 0;
  background: #FFFFFF;
  padding: 23rpx 0 calc(54rpx + constant(safe-area-inset-bottom));
  padding: 23rpx 0 calc(54rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -18rpx 60rpx rgba(0, 0, 0, 0.16);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.sheet-panel-on {
  transform: translateY(0);
}

.sheet-handle {
  width: 77rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #E8DFD4;
  margin: 0 auto 23rpx;
}

.sheet-head,
.sheet-list {
  padding: 0 38rpx;
}

.sheet-title {
  display: block;
  margin-top: 4rpx;
  font-size: 38rpx;
  font-weight: 500;
}

.sheet-close {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #F4ECE2;
  color: #3A322E;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-list {
  margin-top: 31rpx;
}

.sheet-row {
  width: 100%;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  text-align: left;
  transition: opacity 0.2s ease, transform 0.15s ease;
}

.sheet-row:active {
  opacity: 0.76;
  transform: scale(0.99);
}

.sheet-icon,
.row-icon {
  width: 77rpx;
  height: 77rpx;
  border-radius: 50%;
  background: #F4E4DA;
  color: #C2502B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  margin-right: 23rpx;
}

.row-icon-img {
  width: 31rpx;
  height: 31rpx;
}

.sheet-copy {
  flex: 1;
}

.sheet-row-title {
  display: block;
  color: #161311;
  font-size: 27rpx;
  font-weight: 600;
}

.sheet-row-sub {
  display: block;
  margin-top: 4rpx;
  color: #8C817A;
  font-size: 21rpx;
}

.headline {
  margin-top: 4rpx;
  line-height: 1.1;
}

.subcopy {
  display: block;
  margin-top: 15rpx;
  color: #3A322E;
}

.cat-scroll {
  margin: 31rpx -8rpx 0;
  white-space: nowrap;
}

.cat-row {
  display: flex;
  padding: 0 8rpx 8rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 55rpx;
  border-radius: 25rpx;
  border: 2rpx solid #D7CEC2;
  padding: 0 27rpx;
  color: #3A322E;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  margin-right: 15rpx;
  transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
}

.chip-on {
  background: #161311;
  border-color: #161311;
  color: #FFFFFF;
  font-weight: 600;
}

.template-sync {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 23rpx;
  padding: 19rpx 23rpx;
  border: 2rpx solid #E8DFD4;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
}

.template-sync-warn {
  border-color: rgba(194, 80, 43, 0.32);
  background: rgba(255, 247, 241, 0.92);
}

.template-sync-copy {
  flex: 1;
  min-width: 0;
  padding-right: 19rpx;
}

.template-sync-title,
.template-sync-sub {
  display: block;
  line-height: 1.45;
}

.template-sync-title {
  color: #2B2420;
  font-size: 23rpx;
  font-weight: 600;
}

.template-sync-sub {
  margin-top: 4rpx;
  color: #8C817A;
  font-size: 19rpx;
}

.template-sync-btn {
  width: 108rpx;
  height: 54rpx;
  border-radius: 27rpx;
  background: #161311;
  color: #FFFFFF;
  font-size: 21rpx;
  line-height: 54rpx;
}

.template-sync-btn[disabled] {
  opacity: 0.56;
}

.style-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 31rpx;
}

.style-card {
  position: relative;
  width: 325rpx;
  height: 434rpx;
  margin-bottom: 23rpx;
  border-radius: 31rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  text-align: left;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
}

.style-card-on {
  border: 4rpx solid #161311;
  box-shadow: 0 12rpx 28rpx rgba(22, 19, 17, 0.14);
}

.style-card:active {
  transform: scale(0.985);
}

.style-no {
  position: absolute;
  left: 19rpx;
  top: 19rpx;
  border-radius: 4rpx;
  background: rgba(0, 0, 0, 0.36);
  color: #FFFFFF;
  padding: 5rpx 12rpx;
  font-size: 17rpx;
  letter-spacing: 4rpx;
}

.render-badge {
  position: absolute;
  left: 27rpx;
  top: 27rpx;
  border-radius: 4rpx;
  background: rgba(0, 0, 0, 0.36);
  color: #FFFFFF;
  padding: 8rpx 15rpx;
  font-size: 17rpx;
  letter-spacing: 5rpx;
}

.check-dot {
  position: absolute;
  right: 19rpx;
  top: 19rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #161311;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-dot image {
  width: 27rpx;
  height: 27rpx;
}

.style-name-wrap {
  position: absolute;
  left: 23rpx;
  right: 23rpx;
  bottom: 23rpx;
  color: #FFFFFF;
}

.style-en {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 17rpx;
  letter-spacing: 5rpx;
}

.style-name {
  display: block;
  margin-top: 4rpx;
  font-size: 33rpx;
  font-weight: 500;
}

.bottom-action {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: rgba(255, 255, 255, 0.95);
  border-top: 2rpx solid #E8DFD4;
  padding: 23rpx 38rpx calc(54rpx + constant(safe-area-inset-bottom));
  padding: 23rpx 38rpx calc(54rpx + env(safe-area-inset-bottom));
  margin: 0;
  box-sizing: border-box;
}

.result-actions {
  position: relative;
  left: auto;
  bottom: auto;
  z-index: auto;
  width: 100%;
  max-width: none;
  background: transparent;
  border: 0;
  border-radius: 0;
  padding: 15rpx 0 0;
  margin: 15rpx 0 0;
  box-sizing: border-box;
}

.current-style {
  margin-bottom: 23rpx;
}

.current-thumb {
  width: 77rpx;
  height: 92rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  margin-right: 23rpx;
}

.current-copy {
  flex: 1;
}

.current-name {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.quota {
  border: 2rpx solid #E8DFD4;
  border-radius: 25rpx;
  padding: 8rpx 19rpx;
  color: #3A322E;
  font-size: 19rpx;
  letter-spacing: 3rpx;
}

.primary-btn {
  width: 100%;
  min-height: 92rpx;
  border-radius: 46rpx;
  background: #161311;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 92rpx;
  text-align: center;
  transition: transform 0.15s ease, opacity 0.2s ease;
}

.primary-btn:active {
  transform: scale(0.98);
}

.generate-body {
  padding: 2rpx 38rpx 0;
}

.poster-stage,
.result-poster {
  position: relative;
  width: 100%;
  height: 898rpx;
  border-radius: 31rpx;
  overflow: hidden;
  background: #161311;
  box-shadow: 0 20rpx 55rpx rgba(0, 0, 0, 0.22);
}

.dark-cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.15);
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 184rpx;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0));
  opacity: 0.8;
  transition: top 0.6s linear;
}

.particle {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  animation: ppFloat 2.4s ease-in-out infinite alternate;
}

.p1 { left: 14%; top: 20%; }
.p2 { left: 36%; top: 34%; animation-delay: .2s; }
.p3 { left: 62%; top: 24%; animation-delay: .4s; }
.p4 { left: 76%; top: 48%; animation-delay: .6s; }
.p5 { left: 28%; top: 68%; animation-delay: .8s; }

@keyframes ppFloat {
  from { transform: translateY(0); }
  to { transform: translateY(-23rpx); }
}

.poster-caption {
  position: absolute;
  left: 31rpx;
  right: 31rpx;
  bottom: 31rpx;
  color: #FFFFFF;
}

.poster-title {
  display: block;
  margin-top: 4rpx;
