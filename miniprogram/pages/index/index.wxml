      <text class="overline block-title">SECURITY</text>
      <view class="group-card">
        <view class="profile-row"><view class="profile-label"><image class="profile-label-icon" src="/assets/icons/lock-brand.svg" mode="aspectFit" /><text>账号安全</text></view><view><image class="row-chev" src="/assets/icons/chevron-right-muted.svg" mode="aspectFit" /></view></view>
        <view class="profile-row last"><view class="profile-label"><image class="profile-label-icon" src="/assets/icons/shield-brand.svg" mode="aspectFit" /><text>隐私设置</text></view><view><image class="row-chev" src="/assets/icons/chevron-right-muted.svg" mode="aspectFit" /></view></view>
