  <view wx:if="{{current == 'help'}}" class="screen {{screenReady ? 'screen-in' : ''}}">
    <status-bar />
    <mini-nav title="帮助与反馈" show-back="{{true}}" right-capsule="{{false}}" bindback="goBack" />
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="scroll-content plain-scroll">
      <text class="overline">HELP</text>
      <view class="headline"><text class="display mid">有什么</text><text class="display mid accent italic">疑问</text></view>
      <view class="help-cards">
        <view class="help-card"><view class="row-icon warm"><image class="row-icon-img" src="/assets/icons/star-brand.svg" mode="aspectFit" /></view><text>使用指南</text><text>拍摄到生成全流程</text></view>
        <view class="help-card"><view class="row-icon warm"><image class="row-icon-img" src="/assets/icons/star-brand.svg" mode="aspectFit" /></view><text>常见问题</text><text>12 条用户高频问答</text></view>
      </view>

      <text class="overline block-title">FAQ</text>
      <view class="group-card">
        <view wx:for="{{faqs}}" wx:key="q" class="faq-row {{index == faqs.length - 1 ? 'last' : ''}}">
          <text>{{item.q}}</text>
          <text>{{item.a}}</text>
        </view>
      </view>

      <text class="overline block-title">CONTACT</text>
      <view class="contact-card">
        <text class="contact-title">意见与建议</text>
        <text class="contact-sub">告诉我们你想要的下一种风格</text>
        <textarea class="feedback" placeholder="留下你的想法..."></textarea>
        <button class="primary-btn">提交反馈</button>
      </view>
      <text class="version">PETPOSTER · V 1.2.0</text>
    </scroll-view>
  </view>
</view>
